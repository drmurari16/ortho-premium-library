NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_APP_NAME="Ortho Premium Library & Media"

# Supabase variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

# Razorpay variables
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# App security
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://localhost:3000

# Content storage
NEXT_PUBLIC_STORAGE_BUCKET=public
PRIVATE_STORAGE_BUCKET=private

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=
